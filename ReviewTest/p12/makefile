# 定义可执行文件的名称
TARGET = schedule02

# 定义源文件
SRC = schedule02.c

# 定义编译器
CC = gcc

# 定义编译选项
# -Wall: 开启所有警告信息，有助于发现潜在的代码问题
# -g: 生成调试信息，方便后续使用 gdb 进行调试
CFLAGS = -Wall -g

# .PHONY 用于声明伪目标，这些目标并不是实际的文件，而是执行一系列命令
.PHONY: all run clean help

# 默认目标，当你直接在终端输入 make 时，会执行这个目标
all: $(TARGET)
	@echo "=================================================="
	@echo "编译成功！可执行文件已生成: $(TARGET)"
	@echo "你可以使用 \`make run\` 来运行程序，或 \`make clean\` 来清理文件。"
	@echo "=================================================="

# 编译目标：定义了如何从源文件 (.c) 生成可执行文件
$(TARGET): $(SRC)
	$(CC) $(CFLAGS) $^ -o $@
	@echo "正在编译: $^ -> $@"

# 运行目标：用于编译并立即运行程序
run: $(TARGET)
	@echo "=================================================="
	@echo "正在运行 FCFS 调度算法演示程序..."
	@echo "--------------------------------------------------"
	./$(TARGET)
	@echo "=================================================="

# 清理目标：用于删除编译生成的可执行文件和其他可能的中间文件
clean:
	@if [ -f $(TARGET) ]; then \
		rm -f $(TARGET); \
		echo "已删除可执行文件: $(TARGET)"; \
	else \
		echo "没有可清理的文件。"; \
	fi

# 帮助目标：用于显示 Makefile 的使用说明
help:
	@echo "=================================================="
	@echo "FCFS 调度算法演示程序 - Makefile 使用说明"
	@echo "=================================================="
	@echo "用法: make [目标]"
	@echo ""
	@echo "可用目标:"
	@echo "  all       (默认) 编译源文件并生成可执行文件。"
	@echo "  run       编译并运行演示程序。"
	@echo "  clean     删除生成的可执行文件。"
	@echo "  help      显示此帮助信息。"
	@echo ""